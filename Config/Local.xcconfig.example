// Copy to Config/Local.xcconfig (gitignored), fill in, then run `xcodegen` and build.
// Your Team ID: Xcode > Settings > Accounts > your team, or developer.apple.com > Membership details.
DEVELOPMENT_TEAM = ABCDE12345
// A bundle ID your team owns (a bundle ID belongs to one team; com.jsonify.minits is taken).
PRODUCT_BUNDLE_IDENTIFIER = com.example.minits
